# This file is a reference only.
# The application reads environment variables from the process environment;
# it does not automatically load this file.
LLM_PROVIDER=llama_cpp
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_MODEL=local-model
EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
EMBEDDING_MODEL=local-embedding
TABLE_TURN_TEMPERATURE=0.9
DISCOVERY_DISPLAY=gm

